{
  "name": "duolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,game -c cyan,magenta \"next dev -H 0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev -H 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build",
    "start": "concurrently -n web,game \"next start -H 0.0.0.0\" \"tsx server/index.ts\"",
    "test": "tsx --test games/logic/*.test.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
